{
  "name": "school-on",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:content": "tsx scripts/check-catalog.mts",
    "check:model": "tsx --conditions=react-server scripts/check-model.mts",
    "check": "npm run typecheck && npm run lint && npm run check:content && npm run check:model",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.mts",
    "db:check": "tsx --conditions=react-server scripts/db-check.mts",
    "db:seed": "tsx --conditions=react-server scripts/db-seed.mts",
    "db:setup": "tsx --conditions=react-server scripts/db-setup.mts"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}

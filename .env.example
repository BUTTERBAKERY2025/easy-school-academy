# Signs the session cookie. Required in production — the app refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# The database. Set it and the app uses Postgres; leave it unset and it falls
# back to the JSON file below, which is fine for local work and demos but loses
# everything when the instance restarts.
#
# On Render this is injected from the database declared in render.yaml, so there
# is nothing to set. Elsewhere, paste a connection string. With Supabase prefer
# the transaction pooler (port 6543) on a host that scales instances, or the
# direct address (port 5432) for a single long-lived server — the app notices
# which one it was given and stops using prepared statements on the pooler,
# which that mode cannot reuse.
#
# This string contains a password: it belongs in the host's environment, never
# in this repository.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Where the JSON database file lives. Defaults to ./data next to the project.
# On a read-only host the app falls back to the system temp directory, which is
# per-instance and wiped on restart — set this to a durable volume for real use.
# SCHOOL_ON_DATA_DIR=/var/data/school-on
